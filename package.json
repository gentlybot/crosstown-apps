{
  "name": "handoff-apps",
  "private": true,
  "description": "Handoff web apps: the merchant and admin portal, and later the courier app.",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:portal": "pnpm --filter portal dev",
    "dev:courier": "pnpm --filter courier dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "packageManager": "pnpm@10.32.1"
}
